#in jenkins go to setting install docker pipeline plugin
#then restart the jenkins server

   #create a new pipeline job in jenkins
#and paste this pipeline script and run it
pipeline {
    environment {
        registry = "hub.docker.io/app"
        dockerImage=''
    }
    agent any

  //  def image
    stages {
        stage('code from SCM') {
            steps {
              git branch: 'main', credentialsId: 'git-key', url: 'git@github.com:gopal1409/eric-spring-boot-prj-august26.git'   
            }
        }
        stage('build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage('build image') {
            steps {
                script {
                    dockerImage=docker.build registry + "$BUILD_NUMBER"
                }
            }
        }
    }
}
