---
- name: install and configure nginx 
  hosts: web 
  become: yes #this will run this playbook with root privileges
  #we can define some varaibles also for your playbook
  vars:
    ubuntu_packages:
      - nginx
      - ufw
    amazon_packages:
      - nginx
      - firewalld
#where is the diction and where the list of items
  tasks: #all the task need to be define as list of items
    - name: gather fact about the system
      ansible.builtin.setup:
    - name: display the os
      ansible.builtin.debug: #this debug module is like an echo command in linux
        msg: "The OS is {{ ansible_os_family }} and the version is {{ ansible_distribution_version }}"
      
