#lets build it do the unit test and check the code coverage
##it will fail in code coverage
pipeline {
    agent any
    stages {
        stage('code from SCM') {
            steps {
                git branch: 'main', credentialsId: 'git-key', url: 'git@github.com:gopal1409/eric-spring-boot-prj-august26.git'
            }
        }
        stage('mvn build') {
            steps {
                sh 'mvn -B -DskipTests clean package'
            }
        }
        stage('achive artifact') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar',
                   fingerprint: true,
                   onlyIfSuccessful: true
            }
        }
        stage('unit test') {
            steps {
                sh 'mvn test'
                junit 'target/surefire-reports/*.xml'
            }
        }
        stage ('code coverage') {
            steps {
                jacoco()
            }
        }
    }
}

